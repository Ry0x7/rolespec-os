# Database
DATABASE_URL="postgresql://user:password@localhost:5432/rolespec?schema=public&sslmode=verify-full"

# Auth.js
# Without ENCRYPTION_KEY below, this is also the source of the encryption key for
# LLM API keys stored in the DB (HKDF-derived, src/shared/lib/secret-box.ts):
# rotating it then makes any saved key unreadable, and the owner has to re-enter
# it at /settings/ai.
AUTH_SECRET="" # Generate with: openssl rand -base64 32

# Dedicated encryption key for secrets at rest — the LLM API keys stored on
# AiSettings (deployment) and UserAiSettings (per user), src/shared/lib/secret-box.ts.
# Set it and new values are written as `v2` envelopes under this key, so rotating
# AUTH_SECRET (session signing) no longer destroys them. Unset or blank, the app
# falls back to the AUTH_SECRET-derived `v1` scheme and everything keeps working —
# which is fine in development.
# Setting it later does NOT migrate existing `v1` values: they stay bound to
# AUTH_SECRET until you run `npx tsx scripts/reencrypt-secrets.ts --yes` (dry-run
# without --yes). Rotating ENCRYPTION_KEY itself makes `v2` values unreadable.
ENCRYPTION_KEY="" # Generate with: openssl rand -base64 32
# Optional. Auth.js uses it verbatim for redirects, so leave it unset in dev to keep
# LAN/device testing working (it then follows the request host).
# AUTH_URL="http://localhost:3100"

# Set to require an invite code at sign-up for closed beta; leave unset for open
# registration. Server-only — never expose it to the client.
# SIGNUP_INVITE_CODE=""

# OAuth - GitHub (Optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AI Provider — one of: claude-code | codex-cli | opencode-cli | openai | anthropic | deepseek | google | ollama | lmstudio
# Recommended for ZERO-API (subscription auth): claude-code or codex-cli
# Recommended for FREE hosted models with no account: opencode-cli
# Recommended for 100% FREE offline local models: ollama or lmstudio
# Recommended for cloud API: openai, anthropic, deepseek, or google
AI_PROVIDER=claude-code

# Claude Code (default) — uses your Claude subscription via the Claude Code CLI.
# Requires the Claude Code CLI installed AND logged in, OR set CLAUDE_CODE_OAUTH_TOKEN
# from `claude setup-token`. Spawns the `claude` binary as a subprocess:
# LOCAL DEV ONLY — does not run on Vercel serverless/edge.
CLAUDE_CODE_MODEL=sonnet   # or "opus"
# CLAUDE_CODE_OAUTH_TOKEN=""

# ChatGPT via the Codex CLI (only needed if AI_PROVIDER=codex-cli) — uses your
# ChatGPT Plus/Pro subscription. Requires `npm i -g @openai/codex` and `codex
# login` on the machine running RoleSpec; there is no env var for the credential
# (the CLI keeps the OAuth tokens in ~/.codex/auth.json). Spawns `codex exec` as
# a subprocess: LOCAL DEV / SELF-HOST ONLY — does not run on Vercel.
# CODEX_CLI_MODEL=gpt-5.5

# OpenCode free models (only needed if AI_PROVIDER=opencode-cli) — hosted models
# from OpenCode's zero-cost tier. Requires the `opencode` CLI installed and
# `opencode models` run once; there is no API key or account to configure here.
# RoleSpec only offers models the CLI reports as zero-cost under the `opencode`
# provider. Spawns `opencode run` as a subprocess: LOCAL DEV / SELF-HOST ONLY.
# OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free
# OPENCODE_TIMEOUT_MS=180000

# Anthropic API (only needed if AI_PROVIDER=anthropic) — direct API-key access,
# works in serverless environments. Optional: an elevated admin can instead save
# the key at /settings/ai, where it is stored encrypted and wins over this var.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=claude-opus-4-8

# LM Studio (only needed if AI_PROVIDER=lmstudio) — OpenAI-compatible local endpoint
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen3:8b

# Ollama (only needed if AI_PROVIDER=ollama) — OpenAI-compatible local endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5vl:7b

# OpenAI (only needed if AI_PROVIDER=openai). Optional: an elevated admin can
# instead save the key at /settings/ai, where it is stored encrypted and wins
# over this var.
OPENAI_API_KEY=""
# OPENAI_MODEL=gpt-4o

# DeepSeek (only needed if AI_PROVIDER=deepseek) — OpenAI-compatible cloud API,
# works in serverless environments. Users can also save their own DeepSeek key
# at /settings/ai, where it is stored encrypted and wins over this var.
# DEEPSEEK_API_KEY=""
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Google Gemini (only needed if AI_PROVIDER=google) — Generative Language API,
# works in serverless environments. There is no stored deployment Google key:
# this env var is the only place for it. Users can also save their own Google key
# at /settings/ai, where it is stored encrypted and wins over this var.
# GOOGLE_GENERATIVE_AI_API_KEY=""
# GOOGLE_MODEL=gemini-2.5-flash

# Vercel Blob (for export file storage). Blobs are written with access:
# "private", so the blob URL alone serves nothing. Unset, exports fall back to
# local disk under EXPORT_STORAGE_DIR (default: .exports/ in the repo root).
# Either way every download goes through /api/exports, which checks the session
# and that the caller owns the resume. Local disk is fine for dev and
# self-hosted Docker; on Vercel the filesystem is ephemeral, so set the token.
BLOB_READ_WRITE_TOKEN=""
# EXPORT_STORAGE_DIR=""

# How long a generated export is kept, in whole days (positive integer).
# Default 90. /api/cron/prune-exports deletes the ResumeExport rows and the
# stored PDFs (blob and disk) older than this; an invalid value falls back to
# the default. A self-hosted deployment with no cron scheduler must call that
# endpoint itself, or exports are retained indefinitely.
# EXPORT_RETENTION_DAYS="90"

# Email (Resend). Required for password reset — without a key the app falls back
# to printing messages to the server console, which is fine in dev but is refused
# outright when NODE_ENV=production rather than silently dropping a reset link.
# EMAIL_FROM must be an address on a domain verified with the provider.
RESEND_API_KEY=""
EMAIL_FROM="RoleSpec <no-reply@yourdomain.com>"

# FX fallback. Job salaries are shown with a USD/PHP equivalent, using a rate
# fetched daily from open.er-api.com (keyless). This value is only used when that
# lookup fails; unset, the code falls back to 58 pesos per dollar.
# FX_USD_PHP_RATE=""

# Logging. One of: debug | info | warn | error. Unset defaults to `debug` in
# development and `info` in production. Production emits one JSON object per line
# for log drains; development emits `LEVEL [scope] message`.
# LOG_LEVEL=""


# App. Inlined into the client bundle at build time, so it must be set before the
# build, not at runtime. On Vercel, an unset value falls back to
# VERCEL_PROJECT_PRODUCTION_URL (see src/config/site.ts) so links in outbound
# email cannot silently point at localhost — but set it explicitly anyway.
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# Cron (Vercel sends this as `Authorization: Bearer <CRON_SECRET>`)
# Required by /api/cron/prune-rate-limits — the route 401s when unset.
CRON_SECRET=""

# Seed admin (optional). When BOTH are set, `prisma db seed` creates/updates this
# admin instead of the demo one. Without them the demo admin
# (admin@rolespec.dev / demo1234) is only seeded outside production.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Dev admin (optional). Password for the local ADMIN user created by
# `npx tsx scripts/seed-dev-admin.ts` (which always uses dev-admin@rolespec.local).
# DEV_ADMIN_EMAIL is read by scripts/screenshot.ts when signing in as that user.
DEV_ADMIN_EMAIL="dev-admin@rolespec.local"
DEV_ADMIN_PASSWORD="dev-admin-local-1234"

# Build-only flag (optional). Set to 1 by the Dockerfile so `next build` emits
# `.next/standalone` for the container image (next.config.ts `output`). Leave it
# unset for local and Vercel builds — neither consumes .next/standalone.
# DOCKER_BUILD=""

# Dev screenshot script (scripts/screenshot.ts) — app to point the browser at.
SCREENSHOT_BASE_URL="http://localhost:3100"
