# Dependencies and build output are produced inside the image, never copied in.
node_modules
.next
.next-desktop
out
build
coverage

# Prisma client is generated during the build (gitignored source of truth).
src/generated

# VCS and tooling
.git
.gitignore
.github
.vscode
.idea

# Secrets — the container gets its env from compose/env_file at runtime.
.env
.env.*
!.env.docker.example

# Local export storage fallback from dev runs — never bake exports into an image
.exports
resumes
/*.pdf
/*.docx

# Platform / agent scratch
.vercel
.claude
.claude.local.md
.serena
.superpowers
.playwright-mcp
.freebuff
.codex
.agents
.impeccable

# Docs and local scratch output
docs
scripts/screenshots
scripts/ux-audit
scripts/pdf-preview

# Desktop build output and Rust target tree (not used by the container)
desktop

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml
