# Environment for the docker-compose stack (docker-compose.yml).
# Copy to `.env.docker` and fill in. This file is read by the `app` service via
# `env_file`; the `db` and `migrate` services get their settings from compose.
#
#   cp .env.docker.example .env.docker
#   docker compose up -d --build
#
# Note: NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time.
# Changing NEXT_PUBLIC_APP_URL here alone does nothing — edit the build arg in
# docker-compose.yml and rebuild.

# ─── Database ─────────────────────────────────────────────────────────────────
# `db` is the compose service name. The bundled postgres has no TLS, hence
# sslmode=disable. Point this at a managed instance for a real deployment.
DATABASE_URL="postgresql://postgres:postgres@db:5432/rolespec?sslmode=disable"

# ─── Workspace access ─────────────────────────────────────────────────────────
# Signs the owner cookie and derives the legacy v1 encryption key. Required;
# generate once with `openssl rand -base64 32` and keep it stable across restarts.
AUTH_SECRET=""              # Generate with: openssl rand -base64 32
# docker-compose.yml sets `local` because the app port is published on loopback.
# If you expose the container on a LAN or public interface, switch to `unlock`
# and set a 16+ character key; `local` refuses non-loopback requests instead of
# granting passwordless access.
# ROLSPEC_ACCESS_MODE="unlock"
# ROLSPEC_ACCESS_KEY=""      # Generate with: openssl rand -base64 32
# Dedicated encryption key for secrets at rest (the LLM API keys stored on
# AiSettings and UserAiSettings, src/shared/lib/secret-box.ts). Set it and new
# values are written as `v2` envelopes under this key, so rotating AUTH_SECRET no
# longer destroys them. Unset or blank falls back to the AUTH_SECRET-derived `v1`
# scheme. Setting it later does not migrate existing `v1` values — run
# `npx tsx scripts/reencrypt-secrets.ts --yes` for that. Rotating this key makes
# `v2` values unreadable.
ENCRYPTION_KEY=""           # Generate with: openssl rand -base64 32

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Build ────────────────────────────────────────────────────────────────────
# Build-only flag. The Dockerfile already sets DOCKER_BUILD=1, which is what makes
# `next build` emit `.next/standalone` for this image (next.config.ts `output`).
# Listed for reference only — this file is runtime env for the `app` service and
# setting it here has no effect on the build.
# DOCKER_BUILD=1

# ─── AI provider ──────────────────────────────────────────────────────────────
# Container-safe providers: `openai`, `anthropic`, `deepseek` and `google` (plain
# HTTPS API calls).
# `claude-code` / `codex-cli` / `opencode-cli` spawn a CLI as a subprocess and
# `ollama` / `lmstudio` expect a server on the host — all five are LOCAL DEV
# ONLY, do not use them here. docker-compose.yml pins AI_PROVIDER=openai for the
# app service.
# The owner can also override the provider at runtime from /settings/ai (the
# AiSettings row in the database) — do not select a local-only provider there
# while running in a container. The same page can store the OpenAI/Anthropic API
# key (encrypted with a key derived from AUTH_SECRET) instead of setting it here.
AI_PROVIDER=openai
OPENAI_API_KEY=""
# OPENAI_MODEL=gpt-4o

# DeepSeek (only needed if AI_PROVIDER=deepseek) — OpenAI-compatible cloud API,
# container-safe. There is no stored deployment DeepSeek key: this env var is the
# only place for it. The owner can also save a DeepSeek key at /settings/ai,
# encrypted, and AI calls then use that key.
# DEEPSEEK_API_KEY=""
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Google Gemini (only needed if AI_PROVIDER=google) — Generative Language API,
# container-safe. There is no stored deployment Google key: this env var is the
# only place for it. The owner can also save a Google key at /settings/ai,
# encrypted, and AI calls then use that key.
# GOOGLE_GENERATIVE_AI_API_KEY=""
# GOOGLE_MODEL=gemini-2.5-flash

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Sent as `Authorization: Bearer <CRON_SECRET>`; /api/cron/* 401s when unset.
CRON_SECRET=""

# ─── Optional ─────────────────────────────────────────────────────────────────
# Export file storage. With a Vercel Blob token, export files go to the blob
# store as private objects. Unset (the default here), they are written to
# EXPORT_STORAGE_DIR inside the container — docker-compose.yml sets it to
# /app/data/exports, backed by the `export-data` volume. Both backends are read
# back through /api/exports, which checks the session and resume ownership.
# BLOB_READ_WRITE_TOKEN=""

# How long a generated export is kept, in whole days (positive integer).
# Default 90. /api/cron/prune-exports deletes the ResumeExport rows and the
# stored PDFs older than this; an invalid value falls back to the default.
# This image ships no scheduler, so point a host cron / systemd timer at
# GET /api/cron/prune-exports with the CRON_SECRET bearer token — otherwise
# exports are retained indefinitely.
# EXPORT_RETENTION_DAYS="90"
