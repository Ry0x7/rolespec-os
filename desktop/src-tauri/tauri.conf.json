{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoleSpec",
  "version": "1.0.5",
  "identifier": "com.rolespec.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Chryypt",
    "homepage": "https://rolespec.ry0x7.dev",
    "shortDescription": "RoleSpec OS — a private job-search workspace.",
    "longDescription": "RoleSpec OS is a self-hosted job-search workspace for resumes, ATS analysis, job discovery, application tracking and follow-ups. Published by Chryypt.",
    "copyright": "© 2026 Chryypt. AGPL-3.0-or-later.",
    "license": "AGPL-3.0-or-later",
    "category": "Productivity",
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installMode": "currentUser",
        "startMenuFolder": "RoleSpec",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Ry0x7/rolespec-os/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2OEMxODQ2OUZBOURCQTMKUldTajI2bWZSaGlNMXJTRk9TODRQRzA5SGFiZWJCUHF1Rnh2dldmam1nenE1MnEwalRrVXF4VVkK",
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
