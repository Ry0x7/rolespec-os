{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoleSpec",
  "version": "1.0.2",
  "identifier": "com.rolespec.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "RoleSpec OS",
    "homepage": "https://github.com/Ry0x7/rolespec-os",
    "copyright": "© 2026 RoleSpec contributors. AGPL-3.0-or-later.",
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Ry0x7/rolespec-os/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2OEMxODQ2OUZBOURCQTMKUldTajI2bWZSaGlNMXJTRk9TODRQRzA5SGFiZWJCUHF1Rnh2dldmam1nenE1MnEwalRrVXF4VVkK",
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
