{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"
    }
  },
  "crons": [
    {
      "path": "/api/cron/prune-rate-limits",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/prune-exports",
      "schedule": "30 4 * * *"
    }
  ]
}
